<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Juego de Mesa Selfo - Online</title>
  <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
  <style>
    :root {
      --bg-wood: #2c1d11;
      --panel-bg: #f4ebd0;
      --board-bg: #3d2b1f;
      --cell-gray: #808080;
      --cell-stroke: #1a1a1a;
      --accent-gold: #c5a059;
      --text-dark: #2b2118;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Georgia', 'Times New Roman', serif;
      background-color: var(--bg-wood);
      background-image: radial-gradient(circle at center, #3d2817 0%, #1a100a 100%);
      color: var(--text-dark);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 15px;
    }

    .container {
      background: var(--panel-bg);
      border: 8px solid var(--accent-gold);
      border-radius: 12px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.7);
      padding: 20px;
      max-width: 900px;
      width: 100%;
      text-align: center;
    }

    h1 {
      font-size: 2.2rem;
      letter-spacing: 2px;
      margin-bottom: 10px;
      color: #3a220f;
      text-transform: uppercase;
      border-bottom: 2px solid var(--accent-gold);
      padding-bottom: 5px;
    }

    h2 {
      font-size: 1.4rem;
      color: #3a220f;
      margin-bottom: 15px;
    }

    .panel { display: none; }
    .active { display: block; }

    .form-group {
      margin: 15px 0;
      text-align: left;
    }

    label { display: block; font-weight: bold; margin-bottom: 5px; }

    input {
      width: 100%;
      padding: 8px 12px;
      border: 1px solid #a89270;
      border-radius: 4px;
      background: #fffdf5;
      font-family: inherit;
      font-size: 1rem;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .mode-buttons {
      display: flex;
      gap: 15px;
      justify-content: center;
      margin: 20px 0;
    }

    button {
      background: #5c3a21;
      color: #f4ebd0;
      border: 2px solid var(--accent-gold);
      padding: 10px 20px;
      font-size: 1rem;
      font-weight: bold;
      font-family: inherit;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
      margin-top: 5px;
    }

    button:hover {
      background: #7a4e2c;
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    }

    .btn-action {
      padding: 6px 12px;
      font-size: 0.9rem;
      margin-top: 0;
    }

    .btn-draw {
      background: #2b547e;
    }
    .btn-draw:hover {
      background: #3a6898;
    }

    .btn-secondary {
      background: #4a5d4e;
    }
    .btn-secondary:hover {
      background: #5c7462;
    }

    .btn-cancel { background: #800000; }
    .btn-cancel:hover { background: #a00000; }

    .game-header {
      display: flex;
      flex-direction: column;
      gap: 10px;
      background: #e6d7b8;
      padding: 12px 15px;
      border-radius: 6px;
      border: 1px solid #c8b48c;
      margin-bottom: 15px;
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .action-buttons {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .players-list {
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .status-box {
      font-size: 1.15rem;
      font-weight: bold;
      color: #3a220f;
    }

    .game-tag {
      font-family: monospace;
      background: #2b2118;
      color: var(--accent-gold);
      padding: 4px 8px;
      border-radius: 4px;
      user-select: all;
    }

    .player-badge {
      display: inline-flex;
      align-items: center;
      padding: 5px 12px;
      border-radius: 4px;
      font-size: 0.95rem;
      font-weight: bold;
    }

    .badge-black {
      background: #1a1a1a;
      color: #f4ebd0;
      border: 1px solid #333;
    }

    .badge-white {
      background: #ffffff;
      color: #2b2118;
      border: 1px solid #888;
    }

    .board-container {
      background: var(--board-bg);
      border-radius: 8px;
      padding: 10px;
      box-shadow: inset 0 0 15px rgba(0,0,0,0.8);
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: auto;
    }

    svg { user-select: none; }

    .hex {
      fill: var(--cell-gray);
      stroke: var(--cell-stroke);
      stroke-width: 1.5px;
      transition: fill 0.2s;
      cursor: pointer;
    }

    .hex:hover { fill: #999999; }
    .hex.selected { fill: #b39b4d; stroke: #fff; stroke-width: 2.5px; }
    .hex.valid-move { fill: #728c69; stroke: #2e4d23; cursor: pointer; }

    .piece { pointer-events: none; transition: all 0.3s ease; }
    .piece-black { fill: url(#blackPieceGrad); stroke: #000; stroke-width: 1px; }
    .piece-white { fill: url(#whitePieceGrad); stroke: #999; stroke-width: 1px; }

    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.65);
      justify-content: center;
      align-items: center;
      z-index: 100;
    }

    .modal-content {
      background: var(--panel-bg);
      padding: 30px;
      border-radius: 10px;
      border: 4px solid var(--accent-gold);
      text-align: center;
      max-width: 450px;
      width: 90%;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

    .modal-buttons {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin-top: 20px;
      flex-wrap: wrap;
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>SELFO ONLINE</h1>

    <!-- Selección de Modo Inicial -->
    <div id="modePanel" class="panel active">
      <div class="mode-buttons">
        <button onclick="showHostForm()">Crear Nueva Partida</button>
        <button onclick="showJoinForm()">Unirse a Partida</button>
      </div>
    </div>

    <!-- Crear Partida (Jugador 1) -->
    <div id="hostPanel" class="panel">
      <h2>Crear Partida (Jugador 1)</h2>
      <div class="form-group">
        <label for="hostName">Tu Nickname:</label>
        <input type="text" id="hostName" value="Jugador 1">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="boardRadius">Radio del tablero (1-6):</label>
          <input type="number" id="boardRadius" min="1" max="6" value="3">
        </div>
        <div class="form-group">
          <label for="pieceCount">Fichas por jugador:</label>
          <input type="number" id="pieceCount" min="1" max="10" value="3">
        </div>
      </div>
      <button onclick="createRoom()">Generar Sala y Esperar Jugador</button>
      <button onclick="showModePanel()" class="btn-cancel">Volver</button>
    </div>

    <!-- Esperando Jugador -->
    <div id="waitingPanel" class="panel">
      <h2>Partida Creada</h2>
      <p style="margin: 15px 0;">Comparte este código o enlace con el otro jugador:</p>
      <p>Código: <span id="displayRoomCode" class="game-tag"></span></p>
      <button onclick="copyInviteLink()" style="margin: 15px 0;">Copiar Enlace Directo</button>
      <p><i>Esperando a que el Jugador 2 introduzca su nickname y se conecte...</i></p>
    </div>

    <!-- Unirse a Partida (Jugador 2) -->
    <div id="joinPanel" class="panel">
      <h2>Unirse a Partida (Jugador 2)</h2>
      <div class="form-group">
        <label for="guestName">Tu Nickname:</label>
        <input type="text" id="guestName" value="Jugador 2">
      </div>
      <div class="form-group">
        <label for="joinCode">Código de la Sala:</label>
        <input type="text" id="joinCode" placeholder="Ej: SELFO-1234">
      </div>
      <button onclick="joinRoom()">Conectarse a la Partida</button>
      <button onclick="showModePanel()" class="btn-cancel">Volver</button>
    </div>

    <!-- Panel de Juego -->
    <div id="gamePanel" class="panel">
      <div class="game-header">
        <div class="header-top">
          <div>ID: <span id="gameTag" class="game-tag"></span></div>
          <div class="status-box" id="turnStatus"></div>
          <div class="action-buttons">
            <button id="pieBtn" onclick="applyPieRule()" style="display:none;" class="btn-action">Cambiar Color (Pastel)</button>
            <button id="drawBtn" onclick="offerDraw()" style="display:none;" class="btn-action btn-draw">Ofrecer Tablas</button>
            <button id="resignBtn" onclick="resignGame()" style="display:none;" class="btn-action btn-cancel">Abandonar</button>
          </div>
        </div>
        <div class="players-list">
          <span id="blackBadge" class="player-badge badge-black"></span>
          <span id="whiteBadge" class="player-badge badge-white"></span>
        </div>
      </div>
      <div class="board-container">
        <svg id="hexBoard" width="500" height="500">
          <defs>
            <radialGradient id="blackPieceGrad" cx="30%" cy="30%" r="70%">
              <stop offset="0%" stop-color="#555" />
              <stop offset="100%" stop-color="#050505" />
            </radialGradient>
            <radialGradient id="whitePieceGrad" cx="30%" cy="30%" r="70%">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="100%" stop-color="#cccccc" />
            </radialGradient>
          </defs>
        </svg>
      </div>
    </div>
  </div>

  <!-- Modal de Fin de Partida -->
  <div id="winModal" class="modal">
    <div class="modal-content">
      <h2 id="winTitle">¡Partida Concluida!</h2>
      <p id="winMessage" style="font-size: 1.25rem; font-weight: bold; margin: 15px 0; color: #2b2118;"></p>
      <div class="modal-buttons">
        <button onclick="closeModal()" class="btn-secondary">Ver Tablero</button>
        <button onclick="location.reload()">Nueva Partida</button>
      </div>
    </div>
  </div>

  <!-- Modal de Oferta de Tablas -->
  <div id="drawOfferModal" class="modal">
    <div class="modal-content">
      <h2>Oferta de Tablas</h2>
      <p id="drawOfferMessage" style="font-size: 1.15rem; margin: 15px 0; color: #2b2118;"></p>
      <div class="modal-buttons">
        <button onclick="respondDraw(true)">Aceptar Tablas</button>
        <button onclick="respondDraw(false)" class="btn-cancel">Rechazar</button>
      </div>
    </div>
  </div>

  <script>
    const HEX_SIZE = 32;
    let peer = null;
    let conn = null;
    let isHost = false;
    let myColor = null; // 'B' o 'W'
    let localPlayerName = '';

    let config = { radius: 3, pieces: 3 };
    let players = { B: 'Jugador 1', W: 'Jugador 2' };
    let gameState = {
      board: {}, // "q,r" -> 'B' | 'W' | null
      currentTurn: 'B',
      selectedCell: null,
      moveCount: 0,
      pieRuleAvailable: false,
      gameEnded: false,
      winMessageText: ''
    };

    // Auto-detectar código en URL Hash (#SELFO-XXXX)
    window.addEventListener('DOMContentLoaded', () => {
      const hash = window.location.hash.substring(1);
      if (hash.startsWith('SELFO-')) {
        showJoinForm();
        document.getElementById('joinCode').value = hash;
      }
    });

    function showPanel(panelId) {
      document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
      document.getElementById(panelId).classList.add('active');
    }

    function showModePanel() { showPanel('modePanel'); }
    function showHostForm() { showPanel('hostPanel'); }
    function showJoinForm() { showPanel('joinPanel'); }

    function axialKey(q, r) { return `${q},${r}`; }

    function getNeighbors(q, r) {
      const dirs = [[1, 0], [1, -1], [0, -1], [-1, 0], [-1, 1], [0, 1]];
      return dirs.map(([dq, dr]) => ({ q: q + dq, r: r + dr }));
    }

    // --- CONEXIÓN Y RED PEERJS ---

    function createRoom() {
      const nameInput = document.getElementById('hostName').value.trim();
      localPlayerName = nameInput || 'Jugador 1';
      config.radius = parseInt(document.getElementById('boardRadius').value);
      config.pieces = parseInt(document.getElementById('pieceCount').value);

      const maxAvailable = (3 * config.radius * (config.radius - 1) + 1) - 1;
      if (config.pieces * 2 > maxAvailable) {
        alert(`Demasiadas fichas. Máximo: ${Math.floor(maxAvailable / 2)} por jugador.`);
        return;
      }

      isHost = true;
      const roomCode = 'SELFO-' + Math.floor(1000 + Math.random() * 9000);
      document.getElementById('displayRoomCode').innerText = roomCode;
      showPanel('waitingPanel');

      peer = new Peer(roomCode);

      peer.on('connection', (c) => {
        conn = c;
        setupHostConnection();
      });

      peer.on('error', (err) => alert('Error al crear sala: ' + err));
    }

    function joinRoom() {
      const nameInput = document.getElementById('guestName').value.trim();
      localPlayerName = nameInput || 'Jugador 2';
      const code = document.getElementById('joinCode').value.trim().toUpperCase();
      if (!code) { alert('Introduce un código de sala válido.'); return; }

      isHost = false;
      peer = new Peer();

      peer.on('open', () => {
        conn = peer.connect(code);
        setupGuestConnection();
      });

      peer.on('error', (err) => alert('No se pudo conectar a la sala. Revisa el código.'));
    }

    function setupHostConnection() {
      conn.on('data', (data) => {
        if (data.type === 'JOIN_REQUEST') {
          initHostGame(data.guestName || 'Jugador 2');
        } else {
          handleNetworkMessage(data);
        }
      });

      conn.on('close', () => alert('El otro jugador ha abandonado la conexión.'));
    }

    function setupGuestConnection() {
      conn.on('open', () => {
        sendPayload('JOIN_REQUEST', { guestName: localPlayerName });
      });

      conn.on('data', (data) => {
        handleNetworkMessage(data);
      });

      conn.on('close', () => alert('El otro jugador ha abandonado la conexión.'));
    }

    function sendPayload(type, payload = {}) {
      if (conn && conn.open) {
        conn.send({ type, ...payload });
      }
    }

    function initHostGame(guestName) {
      gameState.board = {};
      const R = config.radius - 1;
      for (let q = -R; q <= R; q++) {
        const r1 = Math.max(-R, -q - R);
        const r2 = Math.min(R, -q + R);
        for (let r = r1; r <= r2; r++) {
          gameState.board[axialKey(q, r)] = null;
        }
      }

      const validCells = Object.keys(gameState.board).filter(k => k !== "0,0");
      
      function getDispersed(count, existing) {
        let pool = validCells.filter(k => !existing.includes(k));
        let selected = [];
        for (let i = 0; i < count; i++) {
          if (!pool.length) break;
          if (!selected.length) {
            let idx = Math.floor(Math.random() * pool.length);
            selected.push(pool.splice(idx, 1)[0]);
          } else {
            let bestKey = pool[0], maxDist = -1;
            for (let cand of pool) {
              let [cq, cr] = cand.split(',').map(Number);
              let minD = Math.min(...selected.map(s => {
                let [sq, sr] = s.split(',').map(Number);
                return (Math.abs(cq - sq) + Math.abs(cq + cr - sq - sr) + Math.abs(cr - sr)) / 2;
              }));
              if (minD > maxDist) { maxDist = minD; bestKey = cand; }
            }
            selected.push(bestKey);
            pool = pool.filter(k => k !== bestKey);
          }
        }
        return selected;
      }

      const blackKeys = getDispersed(config.pieces, []);
      const whiteKeys = getDispersed(config.pieces, blackKeys);

      blackKeys.forEach(k => gameState.board[k] = 'B');
      whiteKeys.forEach(k => gameState.board[k] = 'W');

      const hostIsBlack = Math.random() < 0.5;
      const hostColor = hostIsBlack ? 'B' : 'W';
      const guestColor = hostIsBlack ? 'W' : 'B';

      const hostFinalName = localPlayerName || 'Jugador 1';
      const guestFinalName = guestName || 'Jugador 2';

      players[hostColor] = hostFinalName;
      players[guestColor] = guestFinalName;

      const roomCode = peer.id;

      const payload = {
        config,
        board: gameState.board,
        players,
        hostColor,
        roomCode
      };

      sendPayload('INIT_GAME', payload);
      handleNetworkMessage({ type: 'INIT_GAME', ...payload });
    }

    function handleNetworkMessage(data) {
      switch (data.type) {
        case 'INIT_GAME':
          config = data.config;
          gameState.board = data.board;
          players = data.players;
          gameState.currentTurn = 'B';
          gameState.moveCount = 0;
          gameState.pieRuleAvailable = false;
          gameState.gameEnded = false;
          gameState.winMessageText = '';
          
          myColor = isHost ? data.hostColor : (data.hostColor === 'B' ? 'W' : 'B');

          document.getElementById('gameTag').innerText = data.roomCode;
          showPanel('gamePanel');
          updateUI();
          renderBoard();
          break;

        case 'SYNC_MOVE':
          gameState.board[data.fromKey] = null;
          gameState.board[data.toKey] = data.piece;
          gameState.currentTurn = data.nextTurn;
          gameState.moveCount = data.moveCount;
          gameState.pieRuleAvailable = data.pieRuleAvailable;
          gameState.selectedCell = null;

          if (data.winner) {
            gameState.gameEnded = true;
            const winnerName = players[data.winner] || 'Jugador';
            const winnerColorText = data.winner === 'B' ? 'Negras' : 'Blancas';
            
            gameState.winMessageText = `¡Ha ganado ${winnerName} (${winnerColorText})!`;
            
            renderBoard();
            updateUI();
            showWinModal(gameState.winMessageText);
          } else {
            renderBoard();
            updateUI();
          }
          break;

        case 'SYNC_PIE_RULE':
          const tempP = players.B;
          players.B = players.W;
          players.W = tempP;

          myColor = (myColor === 'B') ? 'W' : 'B';
          gameState.currentTurn = 'W';
          gameState.pieRuleAvailable = false;

          renderBoard();
          updateUI();
          break;

        case 'RESIGN':
          gameState.gameEnded = true;
          const winnerColor = data.color === 'B' ? 'W' : 'B';
          const winnerName = players[winnerColor] || 'Jugador';
          const winnerColorText = winnerColor === 'B' ? 'Negras' : 'Blancas';
          
          gameState.winMessageText = `¡Ha ganado ${winnerName} (${winnerColorText}) por abandono!`;
          
          renderBoard();
          updateUI();
          showWinModal(gameState.winMessageText);
          break;

        case 'OFFER_DRAW':
          if (data.color !== myColor) {
            const offererName = players[data.color] || 'El otro jugador';
            const offererColorText = data.color === 'B' ? 'Negras' : 'Blancas';
            document.getElementById('drawOfferMessage').innerText = `¡${offererName} (${offererColorText}) te ha ofrecido tablas! ¿Aceptas?`;
            document.getElementById('drawOfferModal').style.display = 'flex';
          }
          break;

        case 'RESPOND_DRAW':
          if (data.accepted) {
            gameState.gameEnded = true;
            gameState.winMessageText = '¡Partida finalizada en Tablas (Empate)!';
            renderBoard();
            updateUI();
            showWinModal(gameState.winMessageText);
          } else {
            if (data.responderColor !== myColor) {
              alert('El otro jugador ha rechazado la oferta de tablas.');
            }
          }
          break;
      }
    }

    // --- ACCIONES DE JUGADOR ---

    function resignGame() {
      if (gameState.gameEnded) return;
      if (!confirm('¿Estás seguro de que deseas abandonar la partida? Se le dará la victoria al otro jugador.')) return;

      const data = { type: 'RESIGN', color: myColor };
      sendPayload('RESIGN', { color: myColor });
      handleNetworkMessage(data);
    }

    function offerDraw() {
      if (gameState.gameEnded) return;
      sendPayload('OFFER_DRAW', { color: myColor });
      alert('Has ofrecido tablas. Esperando respuesta del otro jugador...');
    }

    function respondDraw(accepted) {
      document.getElementById('drawOfferModal').style.display = 'none';
      const data = { type: 'RESPOND_DRAW', accepted, responderColor: myColor };
      sendPayload('RESPOND_DRAW', { accepted, responderColor: myColor });
      handleNetworkMessage(data);
    }

    // --- TABLERO Y LÓGICA DE JUEGO ---

    function renderBoard() {
      const svg = document.getElementById('hexBoard');
      svg.querySelectorAll('.hex, .piece').forEach(e => e.remove());

      const R = config.radius;
      const width = (R * 2 + 1) * HEX_SIZE * 1.75;
      const height = (R * 2 + 1) * HEX_SIZE * 1.5;
      svg.setAttribute('viewBox', `-${width/2} -${height/2} ${width} ${height}`);

      const validMoves = (!gameState.gameEnded && gameState.selectedCell) ? getValidMoves(gameState.selectedCell) : [];

      Object.keys(gameState.board).forEach(key => {
        const [q, r] = key.split(',').map(Number);
        const { x, y } = hexToPixel(q, r);

        const polygon = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
        polygon.setAttribute('points', getHexPoints(x, y, HEX_SIZE));

        let className = 'hex';
        if (gameState.selectedCell === key) className += ' selected';
        else if (validMoves.includes(key)) className += ' valid-move';

        polygon.setAttribute('class', className);
        polygon.onclick = () => handleCellClick(key);
        svg.appendChild(polygon);

        const piece = gameState.board[key];
        if (piece) {
          const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          circle.setAttribute('cx', x);
          circle.setAttribute('cy', y);
          circle.setAttribute('r', HEX_SIZE * 0.65);
          circle.setAttribute('class', `piece piece-${piece === 'B' ? 'black' : 'white'}`);
          svg.appendChild(circle);
        }
      });
    }

    function hexToPixel(q, r) {
      return {
        x: HEX_SIZE * (Math.sqrt(3) * q + Math.sqrt(3)/2 * r),
        y: HEX_SIZE * (3/2 * r)
      };
    }

    function getHexPoints(cx, cy, size) {
      let points = [];
      for (let i = 0; i < 6; i++) {
        const angle = (Math.PI / 180) * (60 * i - 30);
        points.push(`${cx + size * Math.cos(angle)},${cy + size * Math.sin(angle)}`);
      }
      return points.join(' ');
    }

    function handleCellClick(key) {
      if (gameState.gameEnded || gameState.currentTurn !== myColor) return;

      const piece = gameState.board[key];

      if (gameState.selectedCell) {
        const validMoves = getValidMoves(gameState.selectedCell);
        if (validMoves.includes(key)) {
          const fromKey = gameState.selectedCell;
          const pieceColor = gameState.board[fromKey];

          gameState.board[fromKey] = null;
          gameState.board[key] = pieceColor;
          gameState.moveCount++;
          
          const isPieAvail = (gameState.moveCount === 1);
          const winner = checkWin(pieceColor) ? pieceColor : null;
          const nextTurn = gameState.currentTurn === 'B' ? 'W' : 'B';

          const moveData = {
            fromKey,
            toKey: key,
            piece: pieceColor,
            nextTurn,
            moveCount: gameState.moveCount,
            pieRuleAvailable: isPieAvail,
            winner
          };

          sendPayload('SYNC_MOVE', moveData);
          handleNetworkMessage({ type: 'SYNC_MOVE', ...moveData });
          return;
        }
      }

      if (piece === myColor) {
        gameState.selectedCell = (gameState.selectedCell === key) ? null : key;
        renderBoard();
      }
    }

    function getValidMoves(key) {
      const [q, r] = key.split(',').map(Number);
      return getNeighbors(q, r)
        .map(n => axialKey(n.q, n.r))
        .filter(k => gameState.board[k] === null);
    }

    function applyPieRule() {
      if (gameState.currentTurn !== myColor || !gameState.pieRuleAvailable) return;

      sendPayload('SYNC_PIE_RULE');
      handleNetworkMessage({ type: 'SYNC_PIE_RULE' });
    }

    function checkWin(color) {
      const colorPieces = Object.keys(gameState.board).filter(k => gameState.board[k] === color);
      if (colorPieces.length === 0) return false;

      const visited = new Set();
      const queue = [colorPieces[0]];
      visited.add(colorPieces[0]);

      while (queue.length > 0) {
        const currentKey = queue.shift();
        const [q, r] = currentKey.split(',').map(Number);

        for (let n of getNeighbors(q, r)) {
          const nKey = axialKey(n.q, n.r);
          if (gameState.board[nKey] === color && !visited.has(nKey)) {
            visited.add(nKey);
            queue.push(nKey);
          }
        }
      }

      return visited.size === colorPieces.length;
    }

    function updateUI() {
      const blackName = players.B || 'Jugador 1';
      const whiteName = players.W || 'Jugador 2';

      const blackText = myColor === 'B' ? `${blackName} (Tú)` : blackName;
      const whiteText = myColor === 'W' ? `${whiteName} (Tú)` : whiteName;

      document.getElementById('blackBadge').innerText = `⬛ Negras: ${blackText}`;
      document.getElementById('whiteBadge').innerText = `⬜ Blancas: ${whiteText}`;

      const turnStatusEl = document.getElementById('turnStatus');
      const pieBtn = document.getElementById('pieBtn');
      const drawBtn = document.getElementById('drawBtn');
      const resignBtn = document.getElementById('resignBtn');

      if (gameState.gameEnded) {
        turnStatusEl.innerHTML = `<span style="color: #2e7d32;">🏆 ${gameState.winMessageText}</span>`;
        pieBtn.style.display = 'none';
        drawBtn.style.display = 'none';
        resignBtn.style.display = 'none';
        return;
      }

      const currentTurnPlayer = players[gameState.currentTurn] || 'Jugador';
      const colorText = gameState.currentTurn === 'B' ? 'Negras' : 'Blancas';

      turnStatusEl.innerText = `Turno: ${currentTurnPlayer} (${colorText})`;

      // Mostrar botones de acción
      drawBtn.style.display = 'inline-block';
      resignBtn.style.display = 'inline-block';

      if (gameState.pieRuleAvailable && gameState.currentTurn === myColor && myColor === 'W') {
        pieBtn.style.display = 'inline-block';
      } else {
        pieBtn.style.display = 'none';
      }
    }

    function showWinModal(msg) {
      document.getElementById('winTitle').innerText = '¡Partida Concluida!';
      document.getElementById('winMessage').innerText = msg;
      document.getElementById('winModal').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('winModal').style.display = 'none';
    }

    function copyInviteLink() {
      const code = document.getElementById('displayRoomCode').innerText;
      const url = `${window.location.origin}${window.location.pathname}#${code}`;
      navigator.clipboard.writeText(url).then(() => alert('¡Enlace directo copiado al portapapeles!'));
    }
  </script>
</body>
</html>